# The core's settings at Latere. The database URLs, the authorizer's bearer
# and the service key are Secrets, each named in deployment.yaml; none of
# them is here.
#
# The origin serves the core under /v1/messaging, the prefix the core writes
# in front of every route of its own, so the Ingress does not rewrite.
#
# Every request is decided by platformd's Sermo decider on its internal TLS
# listener; the bearer is the file the Secret sermod-authorizer is mounted
# as. sermod asks the decider its probe at start and does not serve until it
# is refused, as every authorizer refuses it.
SERMO_AUTHORIZER_URL=https://platformd-internal.latere.svc.cluster.local/internal/sermo/authorize
SERMO_AUTHORIZER_TOKEN_FILE=/var/run/sermod-authorizer/token
# The key sermod signs its proposals with as each group's external sender:
# the file the Secret sermod-service-key is mounted as. Every group names it,
# so it is kept for as long as the database is.
SERMO_SERVICE_KEY_FILE=/var/run/sermod-service-key/seed
